(define (problem libero_floor_manipulation)
  (:domain robosuite)
  (:language pick the alphabet soup and place it in the basket)
  (:regions
    (bin_region
        (:target floor)
        (:ranges ((-0.01 0.25 0.01 0.27)))
        (:yaw_rotation ((0 0)))
        (:rgba (0 0 1 0))
      )
    (target_object_region
        (:target floor)
        (:ranges ((-0.145 -0.265 -0.095 -0.215)))
        (:yaw_rotation ((0 0)))
        (:rgba (0 0 1 0))
      )
    (other_object_region_0
        (:target floor)
        (:ranges ((0.025 -0.125 0.07500000000000001 -0.07500000000000001)))
        (:yaw_rotation ((0 0)))
        (:rgba (0 0 1 0))
      )
    (other_object_region_1
        (:target floor)
        (:ranges ((-0.175 0.034999999999999996 -0.125 0.08499999999999999)))
        (:yaw_rotation ((0 0)))
        (:rgba (0 0 1 0))
      )
    (other_object_region_2
        (:target floor)
        (:ranges ((0.07500000000000001 -0.225 0.125 -0.17500000000000002)))
        (:yaw_rotation ((0 0)))
        (:rgba (0 0 1 0))
      )
    (other_object_region_3
        (:target floor)
        (:ranges ((0.125 0.0049999999999999975 0.175 0.055)))
        (:yaw_rotation ((0 0)))
        (:rgba (0 0 1 0))
      )
    (other_object_region_4
        (:target floor)
        (:ranges ((-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)))
        (:yaw_rotation ((0 0)))
        (:rgba (0 0 1 0))
      )
    (contain_region
        (:target basket_1)
        (:yaw_rotation ((0 0)))
        (:rgba (0 0 1 0))
      )
    (wine_bottle_3_region
        (:target floor)
        (:ranges ((-0.2120445791126893 0.18504170873896664 -0.1320445791126893 0.26504170873896665)))
        (:yaw_rotation ((0.0 0.0)))
        (:rgba (0 0 1 0))
      )
    )
  (:fixtures
    floor - floor
  )
  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_1 - basket
    salad_dressing_1 - salad_dressing
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    tomato_sauce_1 - tomato_sauce
    butter_1 - butter
    wine_bottle_3 - wine_bottle
